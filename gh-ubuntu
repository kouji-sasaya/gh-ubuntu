#!/usr/bin/env bash
set -euo pipefail

TOP="$(cd "$(dirname "$0")" && pwd)"
COMPOSE_FILE="$TOP/docker-compose.yml"
SERVICE_NAME="dev_env"
DEFAULT_UBUNTU_VERSION="24.04"

usage() {
	cat <<'EOF'
Usage: gh-ubuntu <command>

Commands:
  setup   Build docker compose image (20.04 | 22.04 | 24.04 | 26.04)
  shell   Open shell, or run command in container (e.g. gh-ubuntu shell ./hello.sh)

Examples:
  gh ubuntu setup
  gh ubuntu setup 22.04
EOF
}

is_supported_ubuntu_version() {
	case "$1" in
		20.04|22.04|24.04|26.04)
			return 0
			;;
		*)
			return 1
			;;
	esac
}

require_compose_file() {
	if [[ ! -f "$COMPOSE_FILE" ]]; then
		echo "Error: docker-compose.yml not found: $COMPOSE_FILE" >&2
		exit 1
	fi
}

cmd_setup() {
	require_compose_file
	local ubuntu_version="${1:-$DEFAULT_UBUNTU_VERSION}"

	if [[ "$#" -gt 1 ]]; then
		echo "Error: too many arguments for setup" >&2
		echo "Usage: gh ubuntu setup [20.04|22.04|24.04|26.04]" >&2
		exit 1
	fi

	if ! is_supported_ubuntu_version "$ubuntu_version"; then
		echo "Error: unsupported Ubuntu version: $ubuntu_version" >&2
		echo "Supported versions: 20.04, 22.04, 24.04, 26.04" >&2
		exit 1
	fi

	export LOCAL_UID="$(id -u)"
	export LOCAL_GID="$(id -g)"
	export UBUNTU_VERSION="$ubuntu_version"
	docker compose -f "$COMPOSE_FILE" build
}

cmd_shell() {
	require_compose_file
	export LOCAL_UID="$(id -u)"
	export LOCAL_GID="$(id -g)"
	export PWD="$(pwd)"
	docker compose -f "$COMPOSE_FILE" run -q --rm "$SERVICE_NAME" "$@"
}

main() {
	local cmd="${1:-}"
	case "$cmd" in
		setup)
			shift
			cmd_setup "$@"
			;;
		shell)
			shift
			cmd_shell "$@"
			;;
		-h|--help|help|"")
			usage
			;;
		*)
			echo "Error: unknown command: $cmd" >&2
			usage
			exit 1
			;;
	esac
}

main "$@"
